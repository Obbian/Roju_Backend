# App
NODE_ENV=development
PORT=3000

# Database (postgres+postgis, see docker-compose.yml)
DATABASE_URL=postgres://roju:roju@localhost:5432/roju_ride

# Redis (BullMQ outbox relay / job queues / caching)
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# OTP / SMS provider
OTP_PROVIDER_API_KEY=
OTP_TTL_SECONDS=300

# Payments (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Push notifications (FCM/APNs)
FCM_SERVER_KEY=

# Maps / geocoding
GOOGLE_MAPS_API_KEY=
