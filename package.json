{
  "name": "roju-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Roju platform backend — one workspace, one deployable service per app",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:ride": "npm run start:dev -w apps/roju-ride",
    "build:ride": "npm run build -w apps/roju-ride",
    "test:ride": "npm run test -w apps/roju-ride"
  }
}
