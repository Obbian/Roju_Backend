# App
NODE_ENV=development
PORT=3100

# Database — own database, separate from roju-ride's
DATABASE_URL=postgres://roju:roju@localhost:5432/roju_identity

# Redis — OTP state. Can point at the same Redis server as roju-ride (different key
# namespace, "otp:*") or its own instance; either works, this isn't a shared-state concern.
REDIS_URL=redis://localhost:6379

# Auth — MUST match every app that verifies these tokens (roju-ride, roju-fixit, ...).
# This shared-secret (HS256) approach is a deliberate starting point; move to RS256
# (Identity holds the private key, other apps only get the public key) once there's a
# second consumer app to actually prove the key-distribution story out.
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
# Rotated on every use — a device that keeps opening any Roju app stays signed in
# indefinitely (WhatsApp-style); this TTL only bounds an abandoned/unused token.
JWT_REFRESH_EXPIRES_IN=180d

# OTP
OTP_TTL_SECONDS=300

# MSG91 — primary SMS/OTP delivery. Leave blank in dev: the OTP falls back to a console log
# (see src/modules/auth/sms/sms.module.ts) instead of failing when these are unset.
MSG91_AUTH_KEY=
# DLT-approved template id for the OTP message (India requires this — a raw free-text SMS
# isn't deliverable). Create this in the MSG91 dashboard; there's no sensible default.
MSG91_OTP_TEMPLATE_ID=

# Twilio — secondary/backup SMS delivery, tried if MSG91 is unset or fails after its own
# retries. Independent of MSG91 — configure either, both, or neither.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# MSG91 WhatsApp — template notifications/support messages. Not consumed by any code yet;
# there's no Notifications module in either app to hang this off of.
MSG91_WHATSAPP_AUTH_KEY=
MSG91_WHATSAPP_INTEGRATED_NUMBER=
