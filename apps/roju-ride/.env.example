# App
NODE_ENV=development
PORT=3000
# Optional — adds an extra selectable server in Swagger UI (e.g. a temporary ngrok tunnel
# URL) so "Try it out" hits the right host. Leave unset for normal local dev.
PUBLIC_API_URL=

# Database (postgres+postgis, see docker-compose.yml)
DATABASE_URL=postgres://roju:roju@localhost:5432/roju_ride

# Redis (BullMQ outbox relay / job queues / caching)
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=180d

# OTP / SMS provider
OTP_PROVIDER_API_KEY=
OTP_TTL_SECONDS=300

# Payments (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Push notifications (FCM/APNs)
FCM_SERVER_KEY=

# Maps / geocoding
GOOGLE_MAPS_API_KEY=

# Weather-based fare surge (WeatherService, Tomorrow.io). Leave blank in dev: PricingService
# falls back to no weather surge (multiplier 1) instead of failing when this is unset.
TOMORROW_IO_API_KEY=
